{
  "name": "ghumbo",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "env-cmd -f .env node dist/main",
    "start:worker": "node dist/worker.js",
    "dev": "env-cmd -f .env nest start --watch",
    "dev:worker": "env-cmd -f .env node --watch --enable-source-maps dist/worker.js",
    "seed": "tsc -p tsconfig.scripts.json && env-cmd -f .env node dist-scripts/scripts/seed.js",
    "migration:generate": "npm run build && node --env-file=.env node_modules/typeorm/cli.js migration:generate -d dist/configs/data-source.js -p",
    "migration:create": "node node_modules/typeorm/cli.js migration:create",
    "migration:run": "npm run build && node --env-file=.env dist/migrate.js",
    "migration:revert": "npm run build && node --env-file=.env node_modules/typeorm/cli.js migration:revert -d dist/configs/data-source.js",
    "migration:show": "npm run build && node --env-file=.env node_modules/typeorm/cli.js migration:show -d dist/configs/data-source.js",
    "emails:sync": "env-cmd -f .env node scripts/emails/sync.mjs",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@ssut/nestjs-sqs": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "env-cmd": "^11.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.32.1",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "oxlint",
      "prettier --write"
    ]
  }
}
